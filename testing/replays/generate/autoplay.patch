+void GuitarGraph::autoplay(nlohmann::json const& p, double end) {
+	if (!m_drums && !p["track"].get<std::string>().empty()) setTrack(p["track"].get<std::string>());
+	if (!difficulty(Difficulty(p["level"].get<int>()))) { SpdLogger::error(LogSystem::INSTRUMENTS, "AUTOPLAY: no such difficulty"); std::_Exit(4); }
+	m_leftymode.b() = p.value("lefty", false);
+	for (auto const& e: p["events"]) m_autoEvents.emplace_back(e[0].get<double>(), e[1].get<unsigned>(), e[2].get<double>());
+	m_autoEnd = end;
+	m_jointime = -1.0;  // Joined from the start (the audio position is not known yet)
+	setupJoinMenu();
+	m_menu.close();

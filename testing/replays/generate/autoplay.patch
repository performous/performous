+#pragma once
+// TEST HARNESS ONLY (never committed): plays a scripted game so that the old gameplay code produces reports.
+#include <nlohmann/json.hpp>
+#include <cstdlib>
+#include <fstream>
+#include <optional>
+
+inline nlohmann::json const* autoplaySpec() {
+	static std::optional<nlohmann::json> spec = []() -> std::optional<nlohmann::json> {
+		char const* file = std::getenv("PERFORMOUS_AUTOPLAY");
+		if (!file) return std::nullopt;
+		std::ifstream f(file);
+		return nlohmann::json::parse(f);
+	}();
+	return spec ? &*spec : nullptr;
+}
+inline int g_autoplayPending = 0;
